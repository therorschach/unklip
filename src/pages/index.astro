---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BgRemover from '../components/BgRemover.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100 antialiased selection:bg-cyan-500/20 selection:text-cyan-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>Unklip - Free, Instant 4K Background Remover (Remove.bg Alternative)</title>
    <meta name="title" content="Unklip - Free, Instant 4K Background Remover" />
    <meta name="description" content="The free, 100% private alternative to remove.bg. Remove image backgrounds in full native 4K resolution using in-browser WebGPU AI. Zero cloud uploads, zero subscriptions, zero limits." />
    <meta name="keywords" content="remove bg free, remove.bg alternative, background remover webgpu, full resolution background removal, free background eraser, transparent png online" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Unklip - Free, Instant 4K Background Remover" />
    <meta property="og:description" content="Remove image backgrounds in full native 4K resolution directly in your browser. 100% free and private." />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="Unklip - Free, Instant 4K Background Remover" />
    <meta property="twitter:description" content="Remove image backgrounds in full native 4K resolution directly in your browser. 100% free and private." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2322d3ee' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z'/></svg>" />
    <meta name="theme-color" content="#020617" />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <Navbar />

    <main class="flex-grow">
      <Hero />
      <BgRemover />
      <ComparisonTable />
      <Features />
      <Faq />
    </main>

    <Footer />
  </body>
</html>
