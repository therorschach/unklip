---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BgRemover from '../components/BgRemover.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Unklip - Free 4K Background Remover (Remove.bg Alternative)"
  description="Free, 100% private in-browser background remover with WebGPU. Full 4K resolution preserved with zero server uploads."
  canonicalUrl="https://unklip.pages.dev/"
  lang="en"
  ogLocale="en_US"
  ogImage="https://unklip.pages.dev/cover.jpg"
  ogImageAlt="Unklip - Free 4K In-Browser Background Remover"
>
  <Navbar />

  <main class="flex-grow">
    <Hero />
    <BgRemover />
    <ComparisonTable />
    <Features />
    <Faq />
  </main>

  <Footer currentLocale="en" />
</BaseLayout>
