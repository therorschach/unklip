---
// src/components/Faq.astro
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  badge?: string;
  title?: string;
  items?: FaqItem[];
}

const defaultItems: FaqItem[] = [
  {
    q: 'How is Unklip completely free with no limits?',
    a: 'Traditional background removers run on cloud GPU clusters that cost thousands of dollars per month. Unklip uses WebGPU to execute the neural network directly on your computer or phone’s GPU. Because there are no cloud inference costs, we offer full access with zero fees.',
  },
  {
    q: 'Are my images and photos private?',
    a: 'Yes, 100% private. Your images never leave your browser. They are processed entirely on-device and never saved to any database.',
  },
  {
    q: 'Why does remove.bg charge for high resolution while Unklip doesn’t?',
    a: 'Remove.bg downsizes free images to 0.25 megapixels as part of their business model to sell credits. Unklip maintains your original resolution and combines the neural alpha matte directly with your native pixels.',
  },
];

const {
  badge = 'FAQ',
  title = 'Frequently Asked Questions',
  items = defaultItems,
} = Astro.props;
---

<section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
  <div class="text-center mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#EFECE4] border border-[#DDD7CB] text-[#6B655D] text-xs font-semibold uppercase tracking-wider mb-2">
      {badge}
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-[#24211E] tracking-tight">
      {title}
    </h2>
  </div>

  <div class="space-y-3">
    {items.map((item) => (
      <details class="group rounded-xl bg-white border border-[#E6E1D6] p-4 sm:p-5 transition-all [&_svg]:open:rotate-180">
        <summary class="flex items-center justify-between cursor-pointer list-none text-sm sm:text-base font-bold text-[#24211E]">
          <span>{item.q}</span>
          <svg class="w-4 h-4 text-[#736B61] transition-transform duration-200 shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="mt-3 text-xs sm:text-sm text-[#736B61] leading-relaxed">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
