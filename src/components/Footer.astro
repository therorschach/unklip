---
// src/components/Footer.astro
---

<footer class="border-t border-slate-800/80 bg-slate-950/90 text-slate-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-indigo-500 p-[1px] flex items-center justify-center">
          <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center">
            <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
          </div>
        </div>
        <span class="text-lg font-bold text-white tracking-tight">Un<span class="text-cyan-400">klip</span></span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-900 border border-slate-800 text-slate-400">Open & Free</span>
      </div>

      <div class="text-xs text-slate-400 text-center sm:text-right">
        <p>100% In-Browser Inference • Powered by <strong class="text-slate-300">WebGPU</strong> & <strong class="text-slate-300">Astro</strong></p>
        <p class="mt-1">Deployable to Cloudflare Pages & Vercel in 60 seconds.</p>
      </div>
    </div>
  </div>
</footer>
