---

<footer class="border-t border-[#E6E1D6] bg-[#FAF7F2] text-[#736B61] py-8 lg:py-10">
  <div class="max-w-5xl xl:max-w-[1180px] mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-6 h-6 rounded-md bg-[#24211E] text-white flex items-center justify-center font-bold text-xs">
          U
        </div>
        <span class="text-sm font-bold text-[#24211E] tracking-tight">Unklip</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#EFECE4] border border-[#DDD7CB] text-[#736B61]">Free & Private</span>
      </div>

      <div class="text-[11px] sm:text-xs text-[#736B61] text-center sm:text-right">
        <p>In-browser WebGPU inference • No cloud servers</p>
      </div>
    </div>
  </div>
