---
// src/components/Footer.astro
---

<footer class="border-t border-[#E6E1D6] bg-[#FAF7F2] text-[#736B61] py-8 lg:py-12">
  <div class="max-w-5xl xl:max-w-7xl 2xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 lg:gap-3">
        <div class="w-6 h-6 lg:w-7 lg:h-7 rounded-md lg:rounded-lg bg-[#24211E] text-white flex items-center justify-center font-bold text-xs lg:text-sm">
          U
        </div>
        <span class="text-sm lg:text-base font-bold text-[#24211E] tracking-tight">Unklip</span>
        <span class="text-[10px] lg:text-xs px-2 py-0.5 rounded-full bg-[#EFECE4] border border-[#DDD7CB] text-[#736B61]">Free & Private</span>
      </div>

      <div class="text-[11px] lg:text-sm text-[#736B61] text-center sm:text-right">
        <p>In-browser WebGPU inference • No cloud servers</p>
      </div>
    </div>
  </div>
</footer>
