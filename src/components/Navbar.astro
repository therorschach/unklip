---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#F8F5F0]/90 border-b border-[#E6E1D6] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-15 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#24211E] text-[#F8F5F0] flex items-center justify-center font-bold text-sm shadow-sm">
        <svg class="w-4 h-4 text-[#E6E1D6] group-hover:rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-[#24211E]">
            Unklip
          </span>
        </div>
      </div>
    </a>

    <!-- Center Nav links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-[#6B655D]">
      <a href="#tool" class="hover:text-[#24211E] transition-colors">Remover</a>
      <a href="#comparison" class="hover:text-[#24211E] transition-colors">vs Remove.bg</a>
      <a href="#features" class="hover:text-[#24211E] transition-colors">Features</a>
      <a href="#faq" class="hover:text-[#24211E] transition-colors">FAQ</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5">
      <!-- GitHub Star Link -->
      <a
        href="https://github.com/therorschach/unklip"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-[#4A453E] hover:text-[#24211E] bg-[#EFECE4] hover:bg-[#E5E0D5] border border-[#DDD7CB] transition-all shadow-2xs"
        title="Star Unklip on GitHub"
      >
        <svg class="w-3.5 h-3.5 text-[#24211E]" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>Star on GitHub</span>
      </a>

      <!-- Primary Upload Button -->
      <button
        type="button"
        id="nav-upload-btn"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#24211E] text-[#F8F5F0] hover:bg-[#3D3833] transition-all shadow-xs cursor-pointer active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-[#F8F5F0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" x2="12" y1="3" y2="15"/>
        </svg>
        <span>Upload Image</span>
      </button>
    </div>
  </div>
</header>

<script>
  document.getElementById('nav-upload-btn')?.addEventListener('click', () => {
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    if (fileInput) {
      fileInput.click();
    } else {
      const toolSection = document.getElementById('tool');
      toolSection?.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
