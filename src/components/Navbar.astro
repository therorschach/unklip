---
// src/components/Navbar.astro
interface Props {
  homeUrl?: string;
  labels?: {
    tool?: string;
    comparison?: string;
    features?: string;
    faq?: string;
  };
}

const {
  homeUrl = '/',
  labels = {
    tool: 'Remover',
    comparison: 'vs Remove.bg',
    features: 'Features',
    faq: 'FAQ',
  },
} = Astro.props;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#F8F5F0]/90 border-b border-[#E6E1D6] transition-all">
  <div class="max-w-6xl xl:max-w-[1200px] mx-auto px-4 sm:px-6 h-15 lg:h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#24211E] text-[#F8F5F0] flex items-center justify-center font-bold text-sm shadow-sm">
        <svg class="w-4 h-4 text-[#E6E1D6] group-hover:rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-[#24211E]">
            Unklip
          </span>
        </div>
      </div>
    </a>

    <!-- Center Nav links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-xs sm:text-sm font-semibold text-[#6B655D]">
      <a href="#tool" class="hover:text-[#24211E] transition-colors">{labels.tool ?? 'Remover'}</a>
      <a href="#comparison" class="hover:text-[#24211E] transition-colors">{labels.comparison ?? 'vs Remove.bg'}</a>
      <a href="#features" class="hover:text-[#24211E] transition-colors">{labels.features ?? 'Features'}</a>
      <a href="#faq" class="hover:text-[#24211E] transition-colors">{labels.faq ?? 'FAQ'}</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5">
      <!-- GitHub Star Link -->
      <a
        href="https://github.com/therorschach/unklip"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#24211E] hover:bg-[#38332E] text-[#F8F5F0] transition-all shadow-xs hover:shadow active:scale-95 group"
        title="Star Unklip on GitHub"
      >
        <svg class="w-3.5 h-3.5 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="hidden sm:inline">Star on GitHub</span>
        <span class="sm:hidden">GitHub</span>
        <svg class="w-3.5 h-3.5 text-amber-300 fill-amber-300 group-hover:scale-110 group-hover:rotate-12 transition-transform duration-200 shrink-0" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      </a>
    </div>
  </div>
</header>
