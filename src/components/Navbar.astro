---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#F8F5F0]/90 border-b border-[#E6E1D6] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-15 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#24211E] text-[#F8F5F0] flex items-center justify-center font-bold text-sm shadow-sm">
        <svg class="w-4 h-4 text-[#E6E1D6] group-hover:rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-[#24211E]">
            Unklip
          </span>
        </div>
      </div>
    </a>

    <!-- Center Nav links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-[#6B655D]">
      <a href="#tool" class="hover:text-[#24211E] transition-colors">Remover</a>
      <a href="#comparison" class="hover:text-[#24211E] transition-colors">vs Remove.bg</a>
      <a href="#features" class="hover:text-[#24211E] transition-colors">Features</a>
      <a href="#faq" class="hover:text-[#24211E] transition-colors">FAQ</a>
    </nav>

    <!-- Right Hardware Badge & CTA -->
    <div class="flex items-center gap-2.5">
      <!-- Live WebGPU/WASM Badge -->
      <div id="hardware-badge" class="flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-[#EFECE4] border border-[#DDD7CB] text-[#4A453E]">
        <span class="relative flex h-2 w-2">
          <span id="hw-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
          <span id="hw-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
        </span>
        <span id="hw-text">Checking GPU...</span>
      </div>

      <!-- Privacy Pill -->
      <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200/80">
        <svg class="w-3 h-3 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>100% On-Device</span>
      </div>
    </div>
  </div>
</header>
