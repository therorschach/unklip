---
// src/components/Features.astro
---

<section id="features" class="max-w-5xl xl:max-w-7xl 2xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-18 xl:py-22">
  <div class="text-center mb-10 sm:mb-12 lg:mb-14">
    <div class="inline-flex items-center gap-1.5 px-3 lg:px-4 py-1 lg:py-1.5 rounded-full bg-[#EFECE4] border border-[#DDD7CB] text-[#6B655D] text-xs lg:text-sm font-semibold uppercase tracking-wider mb-2.5 sm:mb-3">
      Key Highlights
    </div>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-bold text-[#24211E] tracking-tight">
      Precision Tools for Quality Output
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-7 xl:gap-8">
    <!-- Card 1 -->
    <div class="rounded-2xl lg:rounded-3xl p-6 lg:p-8 xl:p-9 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 lg:w-12 lg:h-12 xl:w-14 xl:h-14 rounded-xl lg:rounded-2xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 lg:mb-5 font-bold text-sm lg:text-base xl:text-lg">
        4K
      </div>
      <h3 class="text-base lg:text-lg xl:text-xl font-bold text-[#24211E] mb-2 lg:mb-3">Full Resolution Preserved</h3>
      <p class="text-xs sm:text-sm lg:text-base text-[#736B61] leading-relaxed">
        Unklip applies the neural segmentation alpha matte directly onto your original camera pixels so you never lose clarity or detail.
      </p>
    </div>

    <!-- Card 2 -->
    <div class="rounded-2xl lg:rounded-3xl p-6 lg:p-8 xl:p-9 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 lg:w-12 lg:h-12 xl:w-14 xl:h-14 rounded-xl lg:rounded-2xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 lg:mb-5 font-bold text-sm lg:text-base xl:text-lg">
        <svg class="w-5 h-5 lg:w-6 lg:h-6 xl:w-7 xl:h-7 text-[#4A453E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h3 class="text-base lg:text-lg xl:text-xl font-bold text-[#24211E] mb-2 lg:mb-3">100% Private (On-Device)</h3>
      <p class="text-xs sm:text-sm lg:text-base text-[#736B61] leading-relaxed">
        Your photos never touch any remote server. Everything is computed in your browser sandbox with WebGPU hardware acceleration.
      </p>
    </div>

    <!-- Card 3 -->
    <div class="rounded-2xl lg:rounded-3xl p-6 lg:p-8 xl:p-9 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 lg:w-12 lg:h-12 xl:w-14 xl:h-14 rounded-xl lg:rounded-2xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 lg:mb-5 font-bold text-sm lg:text-base xl:text-lg">
        <svg class="w-5 h-5 lg:w-6 lg:h-6 xl:w-7 xl:h-7 text-[#4A453E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <h3 class="text-base lg:text-lg xl:text-xl font-bold text-[#24211E] mb-2 lg:mb-3">Hardware Accelerated</h3>
      <p class="text-xs sm:text-sm lg:text-base text-[#736B61] leading-relaxed">
        Runs parallel compute shaders on your GPU for fast, responsive cuts without server queues or network latency.
      </p>
    </div>
  </div>
</section>
