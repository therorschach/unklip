---
// src/components/Features.astro
---

<section id="features" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="text-center mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
      State of the Art
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Built for Creators, E-Commerce, and Designers
    </h2>
    <p class="mt-4 text-slate-400 max-w-2xl mx-auto text-sm sm:text-base">
      Engineered from the ground up to eliminate subscription fatigue, preserve native image quality, and safeguard your data privacy.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Feature 1: Full Resolution -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-cyan-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="22" x2="18" y1="12" y2="12"/>
          <line x1="6" x2="2" y1="12" y2="12"/>
          <line x1="12" x2="12" y1="6" y2="2"/>
          <line x1="12" x2="12" y1="22" y2="18"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">100% Native 4K Resolution</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Unlike other tools that downscale your free photos to 0.25 MP blurry thumbnails, Unklip preserves your original pixel dimensions and aspect ratio down to the sub-pixel.
      </p>
    </div>

    <!-- Feature 2: WebGPU Acceleration -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-indigo-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">WebGPU Hardware Speed</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Leverages cutting-edge W3C WebGPU technology to run neural inferences on your device's GPU (Apple Silicon, NVIDIA, AMD, Intel). Instant cutouts without server latency.
      </p>
    </div>

    <!-- Feature 3: On-Device Privacy -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-emerald-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">100% Private (No Cloud Uploads)</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Your photos never touch any server. Everything is computed in your browser's private memory sandbox. Safe for legal, medical, corporate, and personal photographs.
      </p>
    </div>

    <!-- Feature 4: E-Commerce Ready -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-amber-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="8" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">Studio Backgrounds</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Generate compliant pure white (#FFFFFF) backgrounds for Amazon, Shopify, eBay, and Etsy product listings with a single click, or add stylish studio colors and blurs.
      </p>
    </div>

    <!-- Feature 5: Hair & Fur Precision -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-fuchsia-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">Hair, Fur & Glass Matting</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Trained on dichotomous image segmentation datasets, RMBG-1.4 handles challenging edge details like stray hairs, animal fur, transparent glassware, and fine lace cleanly.
      </p>
    </div>

    <!-- Feature 6: Clipboard Integration -->
    <div class="rounded-3xl p-8 bg-slate-900/50 border border-slate-800/80 hover:border-sky-500/40 hover:bg-slate-900/80 transition-all duration-300 group">
      <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-3">1-Click Clipboard Copy</h3>
      <p class="text-slate-400 text-sm leading-relaxed">
        Copy transparent PNGs straight to your clipboard with one click and paste directly into Figma, Canva, Photoshop, Illustrator, Google Docs, or Slack without downloading files.
      </p>
    </div>
  </div>
</section>
