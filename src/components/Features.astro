---
// src/components/Features.astro
---

<section id="features" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
  <div class="text-center mb-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#EFECE4] border border-[#DDD7CB] text-[#6B655D] text-xs font-semibold uppercase tracking-wider mb-2.5">
      Key Highlights
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-[#24211E] tracking-tight">
      Precision Tools for Quality Output
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Card 1 -->
    <div class="rounded-2xl p-6 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 rounded-xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 font-bold text-sm">
        4K
      </div>
      <h3 class="text-base font-bold text-[#24211E] mb-2">Full Resolution Preserved</h3>
      <p class="text-xs text-[#736B61] leading-relaxed">
        Unklip applies the neural segmentation alpha matte directly onto your original camera pixels so you never lose clarity or detail.
      </p>
    </div>

    <!-- Card 2 -->
    <div class="rounded-2xl p-6 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 rounded-xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 font-bold text-sm">
        🔒
      </div>
      <h3 class="text-base font-bold text-[#24211E] mb-2">100% Private (On-Device)</h3>
      <p class="text-xs text-[#736B61] leading-relaxed">
        Your photos never touch any remote server. Everything is computed in your browser sandbox with WebGPU hardware acceleration.
      </p>
    </div>

    <!-- Card 3 -->
    <div class="rounded-2xl p-6 bg-white border border-[#E6E1D6] shadow-xs">
      <div class="w-10 h-10 rounded-xl bg-[#FAF7F2] border border-[#DDD7CB] text-[#24211E] flex items-center justify-center mb-4 font-bold text-sm">
        ⚡
      </div>
      <h3 class="text-base font-bold text-[#24211E] mb-2">Hardware Accelerated</h3>
      <p class="text-xs text-[#736B61] leading-relaxed">
        Runs parallel compute shaders on your GPU for fast, responsive cuts without server queues or network latency.
      </p>
    </div>
  </div>
</section>
