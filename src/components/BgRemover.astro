---
// src/components/BgRemover.astro
---

<section id="tool" class="max-w-5xl xl:max-w-[1180px] mx-auto px-3.5 sm:px-6 lg:px-8 pt-0.5 sm:pt-1 pb-8 sm:pb-14 lg:pb-16">
  <!-- Container Card -->
  <div class="relative rounded-2xl sm:rounded-2xl bg-white border border-[#E6E1D6] shadow-sm overflow-hidden p-3 sm:p-6 lg:p-7">
    
    <!-- STATE 1: UPLOAD / DROPZONE (Top Priority) -->
    <div id="upload-state" class="flex flex-col items-center">
      <!-- Drag & Drop Area -->
      <div
        id="dropzone"
        class="w-full min-h-[195px] sm:min-h-[270px] lg:min-h-[290px] rounded-xl border border-[#D5CDC0] sm:border-2 sm:border-dashed sm:border-[#D5CDC0] hover:border-[#24211E] bg-gradient-to-b from-[#FAF7F2] to-[#F5EFE6] sm:bg-[#FAF7F2] hover:bg-[#F3EFE7] transition-all duration-200 flex flex-col items-center justify-center p-4 sm:p-6 lg:p-8 text-center cursor-pointer group relative overflow-hidden shadow-2xs sm:shadow-none"
      >
        <input
          type="file"
          id="file-input"
          accept="image/png, image/jpeg, image/jpg, image/webp, image/avif, image/bmp"
          class="hidden"
        />
        <input
          type="file"
          id="camera-input"
          accept="image/*"
          capture="environment"
          class="hidden"
        />

        <!-- Upload Icon -->
        <div class="w-12 h-12 sm:w-14 sm:h-14 lg:w-15 lg:h-15 rounded-2xl bg-white border border-[#DDD7CB] shadow-xs flex items-center justify-center mb-2.5 sm:mb-3.5 group-hover:scale-105 group-hover:border-[#24211E] transition-all duration-200 ring-4 ring-[#FAF7F2]">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 text-[#24211E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" x2="12" y1="3" y2="15"/>
          </svg>
        </div>

        <h3 class="text-lg sm:text-2xl font-extrabold text-[#24211E] mb-1 sm:mb-1.5 tracking-tight">
          <span class="hidden sm:inline">Drop your image here, or <span class="underline underline-offset-4 decoration-[#B8AEA0] group-hover:decoration-[#24211E]">browse</span></span>
          <span class="sm:hidden">Upload an image</span>
        </h3>
        <p class="text-[12px] sm:text-sm text-[#736B61] max-w-md sm:max-w-lg mb-0.5">
          <span class="sm:hidden inline-flex items-center gap-1.5 font-medium text-[#5C564E]">
            <svg class="w-3.5 h-3.5 text-emerald-600 inline shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>100% Private On-Device</span>
            <span class="text-[#A3998D] select-none">•</span>
            <span>Full 4K Quality</span>
          </span>
          <span class="hidden sm:inline">PNG, JPG, or WEBP up to 50MB • Or paste (<kbd class="px-1.5 py-0.5 rounded bg-[#EDE8DF] border border-[#DDD7CB] text-[11px] font-mono text-[#4A453E]">Ctrl+V</kbd>) from clipboard</span>
        </p>

        <!-- Mobile & Quick Actions Bar -->
        <div class="mt-3.5 sm:mt-4 w-full sm:w-auto flex items-center justify-center gap-2.5 relative z-10">
          <button
            type="button"
            id="choose-library-btn"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 h-11.5 sm:h-9 px-4 sm:px-3.5 py-2.5 rounded-xl bg-[#24211E] hover:bg-[#38332E] active:scale-[0.98] text-white text-[13px] sm:text-xs font-bold shadow-xs transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            <span>Choose Photo</span>
          </button>
          <button
            type="button"
            id="take-photo-btn"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 h-11.5 sm:h-9 px-4 sm:px-3.5 py-2.5 rounded-xl bg-white hover:bg-[#FAF7F2] active:bg-[#EDE8DF] active:scale-[0.98] border border-[#D5CDC0] text-[13px] sm:text-xs font-semibold text-[#24211E] shadow-2xs transition-all cursor-pointer hover:border-[#24211E]"
          >
            <svg class="w-4 h-4 text-[#5C564E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
            <span>Take Photo</span>
          </button>
          <button
            type="button"
            id="paste-btn"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-[#EDE8DF] border border-[#D5CDC0] text-xs font-semibold text-[#24211E] shadow-2xs transition-all cursor-pointer hover:border-[#24211E]"
            title="Paste image from clipboard"
          >
            <svg class="w-3.5 h-3.5 text-[#5C564E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span>Paste Image</span>
          </button>
        </div>
      </div>

      <!-- Quick Sample Images -->
      <div class="mt-3.5 sm:mt-5 w-full">
        <div class="flex items-center justify-between mb-2 sm:mb-2.5">
          <span class="text-[11px] sm:text-xs font-bold text-[#5C564E] uppercase tracking-wider">
            <span class="sm:hidden">Or try a sample photo:</span>
            <span class="hidden sm:inline">Try one of these instant test photos:</span>
          </span>
          <span class="text-[10px] sm:text-[11px] text-[#8C847A]">Instant 1-tap</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5 lg:gap-3">
          <!-- Sample 1: Portrait / Fine Hair -->
          <button
            type="button"
            class="sample-btn flex items-center gap-2 p-2 sm:p-2.5 rounded-xl bg-[#FAF7F2] border border-[#E6E1D6] hover:border-[#24211E] hover:bg-[#F3EFE7] active:scale-[0.98] transition-all text-left cursor-pointer group"
            data-sample="/samples/portrait.webp"
            data-name="Portrait (Hair)"
          >
            <img src="/samples/portrait.webp" alt="Portrait" class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover bg-white border border-[#DDD7CB] shrink-0" />
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-[#24211E] group-hover:text-black truncate">Portrait</p>
              <p class="text-[10px] text-[#736B61] truncate">Wispy hair</p>
            </div>
          </button>

          <!-- Sample 2: Sneaker / Product -->
          <button
            type="button"
            class="sample-btn flex items-center gap-2 p-2 sm:p-2.5 rounded-xl bg-[#FAF7F2] border border-[#E6E1D6] hover:border-[#24211E] hover:bg-[#F3EFE7] active:scale-[0.98] transition-all text-left cursor-pointer group"
            data-sample="/samples/sneaker.jpg"
            data-name="Sneaker (Product)"
          >
            <img src="/samples/sneaker.jpg" alt="Sneaker" class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover bg-white border border-[#DDD7CB] shrink-0" />
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-[#24211E] group-hover:text-black truncate">Product</p>
              <p class="text-[10px] text-[#736B61] truncate">E-commerce</p>
            </div>
          </button>

          <!-- Sample 3: Fluffy Cat / Fur -->
          <button
            type="button"
            class="sample-btn flex items-center gap-2 p-2 sm:p-2.5 rounded-xl bg-[#FAF7F2] border border-[#E6E1D6] hover:border-[#24211E] hover:bg-[#F3EFE7] active:scale-[0.98] transition-all text-left cursor-pointer group"
            data-sample="/samples/cat.png"
            data-name="Cat (Fluffy Fur)"
          >
            <img src="/samples/cat.png" alt="Cat" class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover bg-white border border-[#DDD7CB] shrink-0" />
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-[#24211E] group-hover:text-black truncate">Pet / Fur</p>
              <p class="text-[10px] text-[#736B61] truncate">Fluffy edges</p>
            </div>
          </button>

          <!-- Sample 4: Sports / Athlete -->
          <button
            type="button"
            class="sample-btn flex items-center gap-2 p-2 sm:p-2.5 rounded-xl bg-[#FAF7F2] border border-[#E6E1D6] hover:border-[#24211E] hover:bg-[#F3EFE7] active:scale-[0.98] transition-all text-left cursor-pointer group"
            data-sample="/samples/football.jpg"
            data-name="Athlete (Sports)"
          >
            <img src="/samples/football.jpg" alt="Sports" class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover bg-white border border-[#DDD7CB] shrink-0" />
            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-[#24211E] group-hover:text-black truncate">Sports</p>
              <p class="text-[10px] text-[#736B61] truncate">Complex back</p>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- STATE 2: PROCESSING / PROGRESS (Hidden by default) -->
    <div id="processing-state" class="hidden flex-col items-center justify-center py-8 sm:py-12 lg:py-16 text-center max-w-lg lg:max-w-xl mx-auto w-full">
      
      <!-- Interactive Processing Ring with Image Preview (Centered) -->
      <div class="relative w-20 h-20 lg:w-24 lg:h-24 mb-5 mx-auto flex items-center justify-center">
        <!-- Outer Rotating Dashed Ring -->
        <div class="absolute inset-0 rounded-2xl lg:rounded-3xl border-2 border-dashed border-[#24211E]/40 animate-[spin_10s_linear_infinite]"></div>
        
        <!-- Thumbnail Preview -->
        <img
          id="process-thumb"
          src=""
          alt="Processing thumbnail"
          class="relative w-16 h-16 lg:w-20 lg:h-20 rounded-xl lg:rounded-2xl object-cover bg-white shadow-sm border border-[#DDD7CB]"
        />

        <!-- Active Neural Sparkle Badge -->
        <div class="absolute -bottom-1 -right-1 w-6 h-6 lg:w-7 lg:h-7 rounded-full bg-[#24211E] text-[#F8F5F0] flex items-center justify-center shadow-sm">
          <svg class="w-3.5 h-3.5 lg:w-4 lg:h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
          </svg>
        </div>
      </div>

      <!-- Live Title & Step Description -->
      <h3 id="process-title" class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-[#24211E] mb-1 sm:mb-1.5">Removing Background...</h3>
      <p id="process-desc" class="text-xs sm:text-sm lg:text-base text-[#736B61] mb-6 sm:mb-7 max-w-sm sm:max-w-md mx-auto">Segmenting foreground subject and fine edges...</p>

      <!-- Main Interactive Progress Bar Container (0% - 100%) -->
      <div class="w-full bg-[#EFECE4] rounded-full h-3.5 lg:h-4.5 p-0.5 border border-[#DDD7CB] overflow-hidden shadow-inner mb-2.5 lg:mb-3 relative">
        <div
          id="progress-bar"
          class="bg-[#24211E] h-full rounded-full transition-[width] duration-150 ease-out relative overflow-hidden"
          style="width: 0%;"
        >
          <!-- Shimmer glow line -->
          <div class="absolute inset-0 bg-white/20 animate-pulse w-full"></div>
        </div>
      </div>

      <!-- Real-time Status Text & Digital Monospace Percentage -->
      <div class="flex items-center justify-between w-full text-xs sm:text-sm lg:text-base text-[#736B61] px-1">
        <span id="progress-text" class="font-medium text-[#5C564E]">Initializing neural engine...</span>
        <span id="progress-percent" class="font-mono text-xs sm:text-sm font-bold text-[#24211E] bg-[#EFECE4] px-2 lg:px-2.5 py-0.5 rounded-md border border-[#DDD7CB]">0%</span>
      </div>

      <!-- Cancel Action -->
      <button
        type="button"
        id="process-cancel-btn"
        class="mt-4 lg:mt-5 text-xs sm:text-sm font-medium text-[#8C847A] hover:text-[#24211E] underline underline-offset-4 transition-colors cursor-pointer"
      >
        Cancel & try another image
      </button>

      <div class="mt-3 lg:mt-4 text-[11px] sm:text-xs text-[#8C847A]">
        Processed entirely in your browser with WebGPU/WASM • Never sent to any server
      </div>
    </div>

    <!-- STATE 3: STUDIO RESULTS VIEW (Hidden by default) -->
    <div id="result-state" class="hidden flex-col gap-3 sm:gap-5">
      <!-- Top Specs & Status Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 sm:gap-4 pb-2.5 sm:pb-3.5 border-b border-[#E6E1D6] w-full">
        <!-- Row 1 on Mobile: Status Chip & Quick Actions -->
        <div class="flex items-center justify-between w-full sm:w-auto gap-2">
          <!-- Unified Status & Resolution Badge -->
          <div class="inline-flex items-center gap-2 h-8 sm:h-9 px-3 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/90 text-xs font-semibold shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span class="hidden sm:inline">Background Removed</span>
            <span class="hidden sm:inline text-emerald-300">•</span>
            <span id="resolution-badge" class="font-mono text-[11px] sm:text-xs text-emerald-900 font-bold whitespace-nowrap">1920 × 1080 px (100% Native)</span>
          </div>

          <!-- Quick Reset / New Button (Mobile header right) -->
          <div class="flex items-center gap-1.5 sm:hidden">
            <button
              id="mobile-new-btn"
              type="button"
              class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-lg bg-white border border-[#DDD7CB] text-[11px] font-semibold text-[#5C564E] hover:text-[#24211E] active:bg-[#FAF7F2] transition-all shadow-2xs cursor-pointer"
              title="Upload new image"
            >
              <svg class="w-3.5 h-3.5 text-[#5C564E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
              <span>New</span>
            </button>
          </div>
        </div>

        <!-- Row 2 on Mobile / Center on Desktop: View Mode Switcher -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <!-- 3-Segmented View Switcher (Slider | Cutout | Original) -->
          <div class="w-full sm:w-auto inline-flex items-center h-9 p-0.5 bg-[#EDE8DF] border border-[#DDD7CB] rounded-xl text-xs font-medium text-[#736B61] shadow-2xs">
            <button id="view-slider-btn" class="h-full flex-1 sm:flex-none px-3.5 sm:px-3 rounded-lg bg-white text-[#24211E] shadow-2xs font-bold transition-all cursor-pointer flex items-center justify-center text-xs">Slider</button>
            <button id="view-cutout-btn" class="h-full flex-1 sm:flex-none px-3.5 sm:px-3 rounded-lg text-[#665F55] hover:text-[#24211E] transition-all cursor-pointer flex items-center justify-center text-xs font-medium">Cutout</button>
            <button id="view-original-btn" class="h-full flex-1 sm:flex-none px-3.5 sm:px-3 rounded-lg text-[#665F55] hover:text-[#24211E] transition-all cursor-pointer flex items-center justify-center text-xs font-medium">Original</button>
          </div>

          <!-- Hold to Compare Action (Desktop only) -->
          <button
            id="hold-compare-btn"
            type="button"
            class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3 rounded-xl bg-[#EDE8DF] hover:bg-[#E2DBCF] active:bg-[#24211E] active:text-[#F8F5F0] text-[#5C564E] text-xs font-semibold border border-[#DDD7CB] shadow-2xs transition-all cursor-pointer select-none"
            title="Press and hold to view original image"
          >
            <svg class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="pointer-events-none">Hold for Original</span>
          </button>
        </div>

        <!-- Desktop Right Column: Download & Share Buttons -->
        <div class="hidden sm:flex shrink-0 items-center justify-end gap-2">
          <!-- Share / Save to Photos Button (Shown when Web Share API is available) -->
          <button
            id="share-btn"
            type="button"
            class="hidden items-center justify-center gap-1.5 h-9 px-3.5 rounded-xl text-xs font-semibold bg-white hover:bg-[#F3EFE7] text-[#24211E] border border-[#DDD7CB] transition-all cursor-pointer shadow-2xs hover:shadow-xs active:scale-95 whitespace-nowrap"
            title="Share or Save directly to Photos"
          >
            <svg class="w-3.5 h-3.5 text-[#5C564E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" x2="12" y1="2" y2="15"/>
            </svg>
            <span id="share-btn-text">Share</span>
          </button>

          <button
            id="download-btn"
            type="button"
            class="inline-flex items-center justify-center gap-2 h-9 px-4 rounded-xl text-xs font-bold bg-[#24211E] hover:bg-[#38332E] text-[#F8F5F0] transition-all cursor-pointer shadow-2xs hover:shadow-xs active:scale-95 whitespace-nowrap"
          >
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span id="download-btn-text">Download (PNG)</span>
          </button>
        </div>
      </div>

      <!-- Main Canvas / Image Comparison Display Area -->
      <div class="relative w-full rounded-xl overflow-hidden bg-[#F5F2EB] border border-[#E6E1D6] min-h-[320px] sm:min-h-[440px] lg:min-h-[500px] flex items-center justify-center p-3 sm:p-4">
        
        <!-- Viewer Container -->
        <div id="viewer-container" class="relative max-w-full max-h-[62vh] rounded-lg overflow-hidden shadow-md select-none touch-pan-y">
          
          <!-- Background Layer (Solid, Blur, or Transparent Pattern) -->
          <div id="custom-bg-layer" class="absolute inset-0 checkerboard-pattern pointer-events-none transition-all"></div>

          <!-- Blurred original background (shown only when blur is active) -->
          <img id="blur-bg-img" src="" alt="Blurred background" class="absolute inset-0 w-full h-full object-contain pointer-events-none filter blur-xl scale-110 hidden" />

          <!-- Cutout Image Element (Transparent Foreground) -->
          <img
            id="cutout-img"
            src=""
            alt="Cutout result"
            class="relative max-w-full max-h-[62vh] w-auto h-auto object-contain block"
          />

          <!-- Before / After Slider Overlay (Original Image) -->
          <div id="slider-overlay" class="absolute inset-0 overflow-hidden pointer-events-none" style="clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);">
            <img
              id="original-img"
              src=""
              alt="Original image"
              class="absolute top-0 left-0 max-w-none max-h-[62vh] object-contain"
            />
          </div>

          <!-- Divider Line & Slider Handle -->
          <div id="slider-handle" class="absolute top-0 bottom-0 w-1 bg-[#24211E] shadow-md cursor-ew-resize flex items-center justify-center -translate-x-1/2 touch-none" style="left: 50%;">
            <div class="w-7 h-7 rounded-full bg-[#24211E] text-[#F8F5F0] shadow-md flex items-center justify-center font-bold text-xs select-none relative">
              ↔
              <span id="slider-pill" class="absolute -top-7 px-1.5 py-0.5 rounded bg-[#24211E] text-[#F8F5F0] text-[10px] font-mono font-medium shadow-xs whitespace-nowrap pointer-events-none">50%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Primary Action Bar (Prominent Thumb-Friendly CTA) -->
      <div class="flex sm:hidden items-center gap-2.5 w-full">
        <button
          id="mobile-download-btn"
          type="button"
          class="flex-1 inline-flex items-center justify-center gap-2 h-12 px-4 rounded-xl text-[13px] font-bold bg-[#24211E] hover:bg-[#38332E] active:scale-[0.98] text-white shadow-sm transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" x2="12" y1="2" y2="15"/>
          </svg>
          <span id="mobile-download-btn-text">Download (PNG)</span>
        </button>

        <button
          id="mobile-share-btn"
          type="button"
          class="hidden items-center justify-center gap-1.5 h-12 px-4 rounded-xl text-xs font-semibold bg-white hover:bg-[#FAF7F2] active:bg-[#EDE8DF] active:scale-[0.98] text-[#24211E] border border-[#DDD7CB] shadow-2xs transition-all cursor-pointer"
          title="Share image"
        >
          <svg class="w-4 h-4 text-[#5C564E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" x2="12" y1="2" y2="15"/>
          </svg>
          <span>Share</span>
        </button>
      </div>

      <!-- Studio Custom Background & Actions Bar -->
      <div class="bg-[#FAF7F2] rounded-2xl lg:rounded-3xl p-3 sm:p-3.5 lg:p-4.5 xl:p-5 border border-[#E6E1D6] flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 sm:gap-4 shadow-2xs">
        <!-- Left: Background Style Segmented Controls -->
