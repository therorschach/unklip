<!-- Client-side Engine Script -->
<script is:inline>
  // Developer preview hook for visual regression testing
  if (typeof window !== 'undefined' && new URLSearchParams(window.location.search).has('view_result_demo')) {
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        const u = document.getElementById('upload-state');
        const r = document.getElementById('result-state');
        if (u) { u.classList.add('hidden'); u.classList.remove('flex'); }
        if (r) { r.classList.remove('hidden'); r.classList.add('flex'); }
        const c = document.getElementById('cutout-img');
        const o = document.getElementById('original-img');
        if (c) c.src = '/samples/portrait.webp';
        if (o) o.src = '/samples/portrait.webp';
        const b = document.getElementById('resolution-badge');
        if (b) b.textContent = '1254 × 1254 px (100% Native)';
      }, 80);
    });
  }
</script>
<script>
  // Elements
  const uploadState = document.getElementById('upload-state');
  const processingState = document.getElementById('processing-state');
  const resultState = document.getElementById('result-state');
  const errorState = document.getElementById('error-state');

  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const cameraInput = document.getElementById('camera-input') as HTMLInputElement | null;
  const chooseLibraryBtn = document.getElementById('choose-library-btn');
  const takePhotoBtn = document.getElementById('take-photo-btn');
  const pasteBtn = document.getElementById('paste-btn');
  const sampleBtns = document.querySelectorAll('.sample-btn');

  const processTitle = document.getElementById('process-title');
  const processDesc = document.getElementById('process-desc');
  const progressBar = document.getElementById('progress-bar');
  const progressText = document.getElementById('progress-text');
  const progressPercent = document.getElementById('progress-percent');

  const perfBadge = document.getElementById('perf-badge');
  const resolutionBadge = document.getElementById('resolution-badge');
  const viewerContainer = document.getElementById('viewer-container');
  const customBgLayer = document.getElementById('custom-bg-layer');
  const blurBgImg = document.getElementById('blur-bg-img') as HTMLImageElement;
  const cutoutImg = document.getElementById('cutout-img') as HTMLImageElement;
  const originalImg = document.getElementById('original-img') as HTMLImageElement;
  const sliderOverlay = document.getElementById('slider-overlay');
  const sliderHandle = document.getElementById('slider-handle');
  const sliderPill = document.getElementById('slider-pill');

  const viewSliderBtn = document.getElementById('view-slider-btn');
  const viewCutoutBtn = document.getElementById('view-cutout-btn');
  const viewOriginalBtn = document.getElementById('view-original-btn');
  const holdCompareBtn = document.getElementById('hold-compare-btn');

  const bgChoiceBtns = document.querySelectorAll('.bg-choice-btn');
  const customColorInput = document.getElementById('custom-color-input') as HTMLInputElement;
  const customColorDot = document.getElementById('custom-color-dot');
  const customColorBtn = document.getElementById('custom-color-btn');

  const copyBtn = document.getElementById('copy-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const shareBtn = document.getElementById('share-btn');
  const shareBtnText = document.getElementById('share-btn-text');
  const mobileDownloadBtn = document.getElementById('mobile-download-btn');
  const mobileDownloadBtnText = document.getElementById('mobile-download-btn-text');
  const mobileShareBtn = document.getElementById('mobile-share-btn');
  const mobileNewBtn = document.getElementById('mobile-new-btn');
  const downloadBtn = document.getElementById('download-btn');
  const downloadBtnText = document.getElementById('download-btn-text');
  const resetBtn = document.getElementById('reset-btn');
  const errorRetryBtn = document.getElementById('error-retry-btn');
  const errorMessage = document.getElementById('error-message');
  const processCancelBtn = document.getElementById('process-cancel-btn');
  const processThumb = document.getElementById('process-thumb') as HTMLImageElement | null;

  const hwText = document.getElementById('hw-text');
  const hwDot = document.getElementById('hw-dot');
  const hwPing = document.getElementById('hw-ping');

  // Application State
  let worker: Worker | null = null;
  let currentFilename = 'image';
  let originalImageBlob: Blob | null = null;
  let cutoutImageBlob: Blob | null = null;
  let maskImageBlob: Blob | null = null;
  let nativeWidth = 0;
  let nativeHeight = 0;
  let activeBgMode: 'transparent' | 'color' | 'blur' = 'transparent';
  let activeBgColor = '#FFFFFF';
  let sliderPosition = 50;
  let isDraggingSlider = false;
  let currentViewMode: 'slider' | 'cutout' | 'original' = 'slider';
  let isHoldingOriginal = false;
  let isProcessing = false; // true only when the user has actively started bg removal

  // Smooth Interactive 0-100% Progress Engine
  let progressAnimFrame: number | null = null;
  let currentProgressVal = 0;
  let targetProgressVal = 0;

  function resetProgressUI() {
    if (progressAnimFrame) {
      cancelAnimationFrame(progressAnimFrame);
      progressAnimFrame = null;
    }
    currentProgressVal = 0;
    targetProgressVal = 0;
    if (progressBar) progressBar.style.width = '0%';
    if (progressPercent) progressPercent.textContent = '0%';
  }

  function startSmoothProgress(initialTarget = 25) {
    resetProgressUI();
    targetProgressVal = initialTarget;

    const tick = () => {
      if (currentProgressVal < targetProgressVal) {
        const diff = targetProgressVal - currentProgressVal;
        const step = Math.max(0.8, diff * 0.18);
        currentProgressVal = Math.min(targetProgressVal, currentProgressVal + step);
      } else if (isProcessing && targetProgressVal < 98) {
        // Continuous, lively creeping motion so progress is constantly and smoothly advancing
        currentProgressVal = Math.min(95, currentProgressVal + 0.10);
        targetProgressVal = Math.min(95, targetProgressVal + 0.10);
      }

      const rounded = Math.min(100, Math.round(currentProgressVal));
      if (progressBar) progressBar.style.width = `${rounded}%`;
      if (progressPercent) progressPercent.textContent = `${rounded}%`;

      if (currentProgressVal < 100) {
        progressAnimFrame = requestAnimationFrame(tick);
      }
    };

    progressAnimFrame = requestAnimationFrame(tick);
  }

  function setProgressTarget(target: number, title?: string, desc?: string) {
    targetProgressVal = Math.max(targetProgressVal, target);
    if (title && processTitle) processTitle.textContent = title;
    if (desc && processDesc) processDesc.textContent = desc;
  }

  function finishProgress(): Promise<void> {
    return new Promise((resolve) => {
      targetProgressVal = 100;
      if (processTitle) processTitle.textContent = 'Background Removed!';
      if (processDesc) processDesc.textContent = 'Preserving full resolution native output...';
      if (progressText) progressText.textContent = '100% Complete';

      const finishTick = () => {
        if (currentProgressVal < 100) {
          currentProgressVal = Math.min(100, currentProgressVal + 8.0);
          const rounded = Math.round(currentProgressVal);
          if (progressBar) progressBar.style.width = `${rounded}%`;
          if (progressPercent) progressPercent.textContent = `${rounded}%`;
          requestAnimationFrame(finishTick);
        } else {
          if (progressBar) progressBar.style.width = '100%';
          if (progressPercent) progressPercent.textContent = '100%';
          setTimeout(resolve, 40); // Instant snappy 40ms completion
        }
      };
      finishTick();
    });
  }

  // Initialize Web Worker
  let workerTimeoutId: ReturnType<typeof setTimeout> | null = null;
  const WORKER_TIMEOUT_MS = 120_000; // 2 minutes — generous for slow mobile WASM inference

  function clearWorkerTimeout() {
    if (workerTimeoutId !== null) {
      clearTimeout(workerTimeoutId);
      workerTimeoutId = null;
    }
  }

  function initWorker() {
    if (worker) return worker;

    worker = new Worker(
      new URL('../workers/rmbg.worker.ts', import.meta.url),
      { type: 'module' }
    );

    worker.onmessage = (event) => {
      const msg = event.data;

      if (msg.type === 'device_info') {
        updateHardwareBadge(msg.device);
      } else if (msg.type === 'progress') {
        handleProgress(msg.data);
      } else if (msg.type === 'step') {
        // Any step message means the worker is alive — reset timeout
        clearWorkerTimeout();
        workerTimeoutId = setTimeout(onWorkerTimeout, WORKER_TIMEOUT_MS);
        setProgressTarget(msg.percent, msg.title, msg.detail);
        if (progressText) progressText.textContent = msg.detail;
      } else if (msg.type === 'success') {
        clearWorkerTimeout();
        handleSuccess(msg);
      } else if (msg.type === 'error') {
        clearWorkerTimeout();
        handleError(msg.error);
      }
    };

    // Log worker errors without prematurely killing the worker during model fallback/probe
    worker.onerror = (event) => {
      console.warn('Worker error event (non-fatal):', (event as any)?.message || event);
    };

    worker.postMessage({ action: 'get_device' });
    return worker;
  }

  function onWorkerTimeout() {
    console.error('Worker timed out after', WORKER_TIMEOUT_MS, 'ms');
    worker?.terminate();
    worker = null;
    if (isProcessing) {
      isProcessing = false;
      handleError(
        'Processing took too long and was stopped. ' +
        'Try a smaller image or use a desktop browser for large photos.'
      );
    }
  }

  function warmupWorker() {
    const w = initWorker();
    w.postMessage({ action: 'warmup' });
  }

  function updateHardwareBadge(device: 'webgpu' | 'wasm') {
    if (!hwText || !hwDot || !hwPing) return;
    if (device === 'webgpu') {
      hwText.textContent = 'WebGPU (Hardware ⚡)';
      hwDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-600';
      hwPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75';
    } else {
      hwText.textContent = 'WASM (CPU)';
      hwDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-amber-600';
      hwPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-500 opacity-75';
    }
  }

  function handleProgress(info: any) {
    if (!info) return;
    if (info.status === 'progress' && typeof info.progress === 'number') {
      // Scale model download (0..100) to 5..25% of overall pipeline
      const downloadPct = Math.min(25, 5 + Math.round((info.progress / 100) * 20));
      setProgressTarget(downloadPct);
      if (progressText) {
        const file = info.file ? ` (${info.file.split('/').pop()})` : '';
        progressText.textContent = `Downloading neural weights${file}...`;
      }
    } else if (info.status === 'done') {
      if (progressText) progressText.textContent = 'Neural weights loaded!';
      setProgressTarget(25);
    }
  }

  async function handleSuccess(msg: any) {
    isProcessing = false;
    cutoutImageBlob = msg.cutoutBlob;
    maskImageBlob = msg.maskBlob;
    nativeWidth = msg.originalWidth;
    nativeHeight = msg.originalHeight;

    const timeSeconds = (msg.elapsedMs / 1000).toFixed(2);
    if (perfBadge) perfBadge.textContent = `Processed in ${timeSeconds}s (${msg.device.toUpperCase()})`;
    if (resolutionBadge) resolutionBadge.textContent = `${nativeWidth} × ${nativeHeight} px (100% Native)`;

    let cutoutUrl = '';
    if (cutoutImageBlob) {
      cutoutUrl = URL.createObjectURL(cutoutImageBlob);
    } else if (maskImageBlob && originalImageBlob) {
      const compositeBlob = await createCompositeBlob(originalImageBlob, maskImageBlob);
      cutoutImageBlob = compositeBlob;
      cutoutUrl = URL.createObjectURL(compositeBlob);
    }

    if (cutoutImg) {
      cutoutImg.src = cutoutUrl;
    }

    if (originalImageBlob) {
      const origUrl = URL.createObjectURL(originalImageBlob);
      if (originalImg) originalImg.src = origUrl;
      if (blurBgImg) blurBgImg.src = origUrl;
    }

    // Await smooth 100% finish
    await finishProgress();

    showState('result');
    currentViewMode = 'slider';
    if (viewSliderBtn) setActiveViewBtn(viewSliderBtn);

    const initSlider = () => {
      syncSliderDimensions();
      updateSlider(50);
    };

    if (cutoutImg && (cutoutImg as HTMLImageElement).complete) {
      initSlider();
    } else if (cutoutImg) {
      cutoutImg.onload = initSlider;
    }

    requestAnimationFrame(() => {
      initSlider();
      requestAnimationFrame(() => {
        initSlider();
      });
    });
  }

  async function createCompositeBlob(origBlob: Blob, maskBlob: Blob): Promise<Blob> {
    return new Promise((resolve, reject) => {
      const origImg = new Image();
      const mskImg = new Image();
      let loaded = 0;

      const onBothLoaded = () => {
        loaded++;
        if (loaded < 2) return;

        const canvas = document.createElement('canvas');
        canvas.width = origImg.naturalWidth;
        canvas.height = origImg.naturalHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return reject(new Error('Canvas context unavailable'));

        ctx.drawImage(origImg, 0, 0);
        ctx.globalCompositeOperation = 'destination-in';
        ctx.drawImage(mskImg, 0, 0, canvas.width, canvas.height);

        canvas.toBlob((blob) => {
          if (blob) resolve(blob);
          else reject(new Error('Canvas blob generation failed'));
        }, 'image/png');
      };

      origImg.onload = onBothLoaded;
      mskImg.onload = onBothLoaded;
      origImg.src = URL.createObjectURL(origBlob);
      mskImg.src = URL.createObjectURL(maskBlob);
    });
  }

  function handleError(err: string) {
    isProcessing = false;
    resetProgressUI();
    if (errorMessage) errorMessage.textContent = err;
    showState('error');
  }

  function showState(state: 'upload' | 'processing' | 'result' | 'error') {
    if (uploadState) {
      uploadState.classList.toggle('hidden', state !== 'upload');
      uploadState.classList.toggle('flex', state === 'upload');
    }
    if (processingState) {
      processingState.classList.toggle('hidden', state !== 'processing');
      processingState.classList.toggle('flex', state === 'processing');
    }
    if (resultState) {
      resultState.classList.toggle('hidden', state !== 'result');
      resultState.classList.toggle('flex', state === 'result');
    }
    if (errorState) {
      errorState.classList.toggle('hidden', state !== 'error');
      errorState.classList.toggle('flex', state === 'error');
    }
  }

  let currentThreshold = 0.52;
  const cutoffSlider = document.getElementById('cutoff-slider') as HTMLInputElement;
  const cutoffVal = document.getElementById('cutoff-val');

  cutoffSlider?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value, 10);
    if (cutoffVal) {
      cutoffVal.textContent = `${val}%`;
    }
  });

  cutoffSlider?.addEventListener('change', (e) => {
    const pct = parseInt((e.target as HTMLInputElement).value, 10);
    // Map 0..100% to threshold 0.30..0.75
    const thresholdVal = 0.30 + (pct / 100) * 0.45;
    if (originalImageBlob) {
      processImage(originalImageBlob, currentFilename, thresholdVal);
    }
  });

  async function processImage(fileOrBlob: File | Blob, nameHint = 'image', customThreshold = currentThreshold) {
    currentFilename = nameHint.replace(/\.[^/.]+$/, '');
    originalImageBlob = fileOrBlob;
    currentThreshold = customThreshold;

    // Display image preview immediately in processing card
    if (processThumb) {
      processThumb.src = URL.createObjectURL(fileOrBlob);
    }

    showState('processing');
    startSmoothProgress(25);
    isProcessing = true;

    // Start timeout watchdog — if the worker doesn't respond within the
    // timeout window, we kill it and show an error instead of hanging forever.
    clearWorkerTimeout();
    workerTimeoutId = setTimeout(onWorkerTimeout, WORKER_TIMEOUT_MS);

    const w = initWorker();
    w.postMessage({
      action: 'remove_bg',
      imageBlob: fileOrBlob,
      threshold: currentThreshold,
      id: Date.now(),
    });
  }

  processCancelBtn?.addEventListener('click', () => {
    isProcessing = false;
    clearWorkerTimeout();
    resetProgressUI();
    showState('upload');
    if (fileInput) fileInput.value = '';
  });

  function syncSliderDimensions() {
    if (!cutoutImg || !originalImg) return;
    if (cutoutImg.clientWidth > 0 && cutoutImg.clientHeight > 0) {
      originalImg.style.width = `${cutoutImg.clientWidth}px`;
      originalImg.style.height = `${cutoutImg.clientHeight}px`;
    }
  }

  window.addEventListener('resize', syncSliderDimensions);

  function updateSlider(percent: number) {
    sliderPosition = Math.max(0, Math.min(100, percent));
    if (sliderOverlay) {
      sliderOverlay.style.clipPath = `polygon(${sliderPosition}% 0, 100% 0, 100% 100%, ${sliderPosition}% 100%)`;
    }
    if (sliderHandle) {
      sliderHandle.style.left = `${sliderPosition}%`;
    }
    if (sliderPill) {
      sliderPill.textContent = `${Math.round(sliderPosition)}%`;
    }
  }

  function handleSliderMove(e: MouseEvent | TouchEvent) {
    if (!isDraggingSlider || !viewerContainer || currentViewMode !== 'slider') return;
    const rect = viewerContainer.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
    const offset = clientX - rect.left;
    const pct = (offset / rect.width) * 100;
    updateSlider(pct);
  }

  viewerContainer?.addEventListener('mousedown', (e) => {
    if (currentViewMode === 'slider') {
      isDraggingSlider = true;
      handleSliderMove(e);
    }
  });
  sliderHandle?.addEventListener('touchstart', (e) => {
    if (currentViewMode === 'slider') {
      isDraggingSlider = true;
      handleSliderMove(e);
    }
  }, { passive: true });
  viewerContainer?.addEventListener('touchstart', (e) => {
    if (currentViewMode === 'slider') {
      isDraggingSlider = true;
      handleSliderMove(e);
    } else if (currentViewMode === 'cutout') {
      startHoldOriginal();
    }
  }, { passive: true });

  window.addEventListener('mousemove', handleSliderMove);
  window.addEventListener('touchmove', handleSliderMove, { passive: true });
  window.addEventListener('mouseup', () => { isDraggingSlider = false; });
  window.addEventListener('touchend', () => { isDraggingSlider = false; });
  window.addEventListener('touchcancel', () => { isDraggingSlider = false; });

  viewSliderBtn?.addEventListener('click', () => {
    currentViewMode = 'slider';
    if (sliderOverlay) sliderOverlay.style.display = 'block';
    if (sliderHandle) sliderHandle.style.display = 'flex';
    updateSlider(50);
    setActiveViewBtn(viewSliderBtn);
  });

  viewCutoutBtn?.addEventListener('click', () => {
    currentViewMode = 'cutout';
    if (sliderOverlay) sliderOverlay.style.display = 'none';
    if (sliderHandle) sliderHandle.style.display = 'none';
    setActiveViewBtn(viewCutoutBtn);
  });

  viewOriginalBtn?.addEventListener('click', () => {
    currentViewMode = 'original';
    if (sliderOverlay) {
      sliderOverlay.style.display = 'block';
      sliderOverlay.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
    }
    if (sliderHandle) sliderHandle.style.display = 'none';
    setActiveViewBtn(viewOriginalBtn);
  });

  function startHoldOriginal() {
    if (isHoldingOriginal) return;
    isHoldingOriginal = true;
    if (sliderOverlay) {
      sliderOverlay.style.display = 'block';
      sliderOverlay.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
    }
    if (sliderHandle) sliderHandle.style.display = 'none';
  }

  function stopHoldOriginal() {
    if (!isHoldingOriginal) return;
    isHoldingOriginal = false;
    if (currentViewMode === 'slider') {
      if (sliderOverlay) {
        sliderOverlay.style.display = 'block';
        sliderOverlay.style.clipPath = `polygon(${sliderPosition}% 0, 100% 0, 100% 100%, ${sliderPosition}% 100%)`;
      }
      if (sliderHandle) sliderHandle.style.display = 'flex';
    } else if (currentViewMode === 'cutout') {
      if (sliderOverlay) sliderOverlay.style.display = 'none';
      if (sliderHandle) sliderHandle.style.display = 'none';
    } else if (currentViewMode === 'original') {
      if (sliderOverlay) {
        sliderOverlay.style.display = 'block';
        sliderOverlay.style.clipPath = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
      }
      if (sliderHandle) sliderHandle.style.display = 'none';
    }
  }

  holdCompareBtn?.addEventListener('mousedown', (e) => {
    e.preventDefault();
    startHoldOriginal();
  });
  holdCompareBtn?.addEventListener('touchstart', (e) => {
    e.preventDefault();
    startHoldOriginal();
  }, { passive: false });

  window.addEventListener('mouseup', stopHoldOriginal);
  window.addEventListener('touchend', stopHoldOriginal);
  window.addEventListener('touchcancel', stopHoldOriginal);

  function setActiveViewBtn(activeBtn: HTMLElement) {
    [viewSliderBtn, viewCutoutBtn, viewOriginalBtn].forEach((btn) => {
      if (!btn) return;
      btn.className = btn === activeBtn
        ? 'h-full flex-1 sm:flex-none px-3.5 sm:px-3 rounded-lg bg-white text-[#24211E] shadow-2xs font-bold transition-all cursor-pointer flex items-center justify-center text-xs'
        : 'h-full flex-1 sm:flex-none px-3.5 sm:px-3 rounded-lg text-[#665F55] hover:text-[#24211E] transition-all cursor-pointer flex items-center justify-center text-xs font-medium';
    });
  }

  const bgActiveClasses = 'bg-choice-btn px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-[#24211E] text-white shadow-2xs flex items-center gap-1.5 cursor-pointer transition-all';
  const bgInactiveClasses = 'bg-choice-btn px-2.5 py-1.5 rounded-lg text-xs font-medium text-[#5C564E] hover:text-[#24211E] hover:bg-white/80 flex items-center gap-1.5 cursor-pointer transition-all';

  function setBgBtnActive(activeBtn: Element | null) {
    bgChoiceBtns.forEach((b) => {
      b.className = (b === activeBtn) ? bgActiveClasses : bgInactiveClasses;
    });
  }

  bgChoiceBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const bgType = btn.getAttribute('data-bg');
      if (bgType === 'custom') {
        activeBgMode = 'color';
        activeBgColor = customColorInput ? customColorInput.value : '#E8E2D6';
        setBgBtnActive(btn);
        if (customBgLayer) {
          customBgLayer.className = 'absolute inset-0 pointer-events-none transition-all';
          customBgLayer.style.backgroundColor = activeBgColor;
        }
        if (blurBgImg) blurBgImg.classList.add('hidden');
        return;
      }

      setBgBtnActive(btn);

      if (bgType === 'transparent') {
        activeBgMode = 'transparent';
        if (customBgLayer) {
          customBgLayer.className = 'absolute inset-0 checkerboard-pattern pointer-events-none transition-all';
          customBgLayer.style.backgroundColor = '';
        }
        if (blurBgImg) blurBgImg.classList.add('hidden');
      } else if (bgType === 'color') {
        activeBgMode = 'color';
        activeBgColor = btn.getAttribute('data-color') || '#FFFFFF';
        if (customBgLayer) {
          customBgLayer.className = 'absolute inset-0 pointer-events-none transition-all';
          customBgLayer.style.backgroundColor = activeBgColor;
        }
        if (blurBgImg) blurBgImg.classList.add('hidden');
      } else if (bgType === 'blur') {
        activeBgMode = 'blur';
        if (customBgLayer) {
          customBgLayer.className = 'absolute inset-0 pointer-events-none transition-all';
          customBgLayer.style.backgroundColor = 'transparent';
        }
        if (blurBgImg) blurBgImg.classList.remove('hidden');
      }
    });
  });

  customColorInput?.addEventListener('input', (e) => {
    const color = (e.target as HTMLInputElement).value;
    activeBgMode = 'color';
    activeBgColor = color;
    if (customColorDot) {
      customColorDot.style.backgroundColor = color;
    }
    setBgBtnActive(customColorBtn);
    if (customBgLayer) {
      customBgLayer.className = 'absolute inset-0 pointer-events-none transition-all';
      customBgLayer.style.backgroundColor = color;
    }
    if (blurBgImg) blurBgImg.classList.add('hidden');
  });

  async function generateFinalComposite(): Promise<Blob> {
    if (activeBgMode === 'transparent' && cutoutImageBlob) {
      return cutoutImageBlob;
    }

    return new Promise((resolve, reject) => {
      const canvas = document.createElement('canvas');
      canvas.width = nativeWidth;
      canvas.height = nativeHeight;
      const ctx = canvas.getContext('2d');
      if (!ctx) return reject(new Error('Canvas context failed'));

      const cutImg = new Image();
      cutImg.onload = () => {
        if (activeBgMode === 'color') {
          ctx.fillStyle = activeBgColor;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(cutImg, 0, 0);
          canvas.toBlob((b) => b ? resolve(b) : reject(new Error('Blob error')), 'image/png');
        } else if (activeBgMode === 'blur') {
          const orig = new Image();
          orig.onload = () => {
            ctx.save();
            ctx.filter = 'blur(30px)';
            ctx.drawImage(orig, -40, -40, canvas.width + 80, canvas.height + 80);
            ctx.restore();
            ctx.drawImage(cutImg, 0, 0);
            canvas.toBlob((b) => b ? resolve(b) : reject(new Error('Blob error')), 'image/png');
          };
          orig.src = cutoutImg.src;
        } else {
          ctx.drawImage(cutImg, 0, 0);
          canvas.toBlob((b) => b ? resolve(b) : reject(new Error('Blob error')), 'image/png');
        }
      };
      cutImg.src = cutoutImg.src;
    });
  }

  mobileDownloadBtn?.addEventListener('click', () => downloadBtn?.click());
  mobileShareBtn?.addEventListener('click', () => shareBtn?.click());
  mobileNewBtn?.addEventListener('click', () => resetBtn?.click());

  downloadBtn?.addEventListener('click', async () => {
    if (!downloadBtnText) return;
    const oldText = downloadBtnText.textContent;
    downloadBtnText.textContent = 'Generating...';
      if (mobileDownloadBtnText) mobileDownloadBtnText.textContent = 'Generating...';

    try {
      const finalBlob = await generateFinalComposite();
      const url = URL.createObjectURL(finalBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${currentFilename}-unklip.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (e) {
      console.error('Download error:', e);
    } finally {
      downloadBtnText.textContent = oldText;
      if (mobileDownloadBtnText) mobileDownloadBtnText.textContent = oldText;
    }
  });

  if (typeof navigator !== 'undefined' && 'share' in navigator && shareBtn) {
    shareBtn.classList.remove('hidden');
    shareBtn.classList.add('inline-flex');
    if (mobileShareBtn) {
      mobileShareBtn.classList.remove('hidden');
      mobileShareBtn.classList.add('inline-flex');
    }
  }

  shareBtn?.addEventListener('click', async () => {
    if (!shareBtnText) return;
    const oldText = shareBtnText.textContent;
    shareBtnText.textContent = 'Preparing...';

    try {
      const finalBlob = await generateFinalComposite();
      const file = new File([finalBlob], `${currentFilename}-unklip.png`, { type: 'image/png' });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        await navigator.share({
          files: [file],
          title: `${currentFilename} - Background Removed`,
        });
      } else {
        await navigator.share({
          title: 'Unklip - Free 4K Background Remover',
          url: window.location.href,
        });
      }
    } catch (err: any) {
      if (err.name !== 'AbortError') {
        console.warn('Share error:', err);
      }
    } finally {
      shareBtnText.textContent = oldText;
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!copyBtnText) return;
    const oldText = copyBtnText.textContent;
    copyBtnText.textContent = 'Copying...';

    try {
      const finalBlob = await generateFinalComposite();
      await navigator.clipboard.write([
        new ClipboardItem({ 'image/png': finalBlob })
      ]);
      copyBtnText.textContent = '✓ Copied!';
      setTimeout(() => {
        copyBtnText.textContent = oldText;
      }, 2500);
    } catch (e) {
      console.warn('Clipboard write failed:', e);
      copyBtnText.textContent = 'Unavailable';
      setTimeout(() => {
        copyBtnText.textContent = oldText;
      }, 2500);
    }
  });

  resetBtn?.addEventListener('click', () => {
    showState('upload');
    if (fileInput) fileInput.value = '';
    if (cameraInput) cameraInput.value = '';
  });
  errorRetryBtn?.addEventListener('click', () => {
    showState('upload');
    if (fileInput) fileInput.value = '';
    if (cameraInput) cameraInput.value = '';
  });

  chooseLibraryBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  takePhotoBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    cameraInput?.click();
  });

  cameraInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processImage(file, 'camera-photo.jpg');
  });

  async function pasteFromClipboard() {
    if (!navigator.clipboard) {
      alert('Clipboard access is not supported in this browser.');
      return;
    }
    try {
      if (navigator.clipboard.read) {
        const items = await navigator.clipboard.read();
        for (const item of items) {
          const imageType = item.types.find((t) => t.startsWith('image/'));
          if (imageType) {
            const blob = await item.getType(imageType);
            processImage(blob, 'clipboard-image.png');
            return;
          }
        }
      }
      alert('No image found in clipboard. Please copy an image first.');
    } catch (err: any) {
      console.warn('Clipboard read error:', err);
      alert('Could not read clipboard. Please ensure clipboard permission is allowed.');
    }
  }

  pasteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    pasteFromClipboard();
  });

  dropzone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processImage(file, file.name);
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#24211E]', 'bg-[#EDE8DF]');
  });
  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-[#24211E]', 'bg-[#EDE8DF]');
  });
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#24211E]', 'bg-[#EDE8DF]');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) {
      processImage(file, file.name);
    }
  });

  window.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) {
          processImage(file, 'clipboard-image.png');
          break;
        }
      }
    }
  });

  sampleBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const sampleUrl = btn.getAttribute('data-sample');
      const sampleName = btn.getAttribute('data-name') || 'sample';
      if (!sampleUrl) return;

      try {
        const resp = await fetch(sampleUrl);
        const blob = await resp.blob();
        processImage(blob, sampleName);
      } catch (err) {
        console.error('Failed to load sample image:', err);
      }
    });
  });

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(() => warmupWorker());
  } else {
    setTimeout(warmupWorker, 1500);
  }
</script>
